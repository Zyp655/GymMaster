APP_ENV=dev
SERVER_PORT=8000
# Danh sách origin được phép gọi API (ngăn bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=gymmaster
DB_PASSWORD=gymmaster
DB_NAME=gymmaster
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_LOG_SQL=false

# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=gymmaster-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Tài khoản OWNER được tạo bởi `make seed`
SEED_ADMIN_EMAIL=admin@gymmaster.vn
SEED_ADMIN_PASSWORD=Admin@123

# Upload file (ảnh hội viên, sản phẩm)
UPLOAD_DIR=resource/uploads
UPLOAD_PUBLIC_URL=http://localhost:8000/uploads
UPLOAD_MAX_SIZE_MB=5

# Email (dev: Mailpit trong docker-compose, giao diện http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GymMaster <no-reply@gymmaster.vn>

# Job định kỳ (hết hạn gói, nhắc gia hạn, no-show...)
CRON_ENABLED=true
